{
  "type": "module",
  "name": "@hazae41/memory-wasm",
  "version": "2.0.9",
  "description": "Zero-copy memory for WebAssembly",
  "repository": "github:hazae41/memory.wasm",
  "author": "hazae41",
  "scripts": {
    "examine": "deno lint ./src/node && deno check ./src/node && deno test ./src/node",
    "compile": "docker compose up --build --exit-code-from app && deno -RW ./patch.wasm.ts",
    "prepack": "rm -rf ./out && tsc && cp -r ./src/wasm/. ./out/wasm && tscousin && deno -RW ./patch.node.ts"
  },
  "files": [
    "./out"
  ],
  "exports": {
    ".": {
      "types": "./out/node/mod.d.ts",
      "import": "./out/node/mod.js"
    }
  },
  "keywords": [
    "reproducible",
    "webassembly",
    "memory",
    "bytes",
    "reference",
    "box",
    "browser",
    "typescript",
    "rust",
    "unit-tested",
    "deno"
  ],
  "devDependencies": {
    "@hazae41/tscousin": "^1.0.28",
    "@types/node": "^25.9.1",
    "deno": "^2.7.14",
    "typescript": "^6.0.3"
  }
}
